{
  "name": "adaptive-ai-server",
  "version": "1.0.0",
  "description": "AdaptiveAI Backend - Personalized AI Experience Engine",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node src/database/seed.js",
    "db:seed:demo": "node src/database/seedDemoUsers.js",
    "db:studio": "prisma studio",
    "db:setup": "prisma generate && prisma db push && node src/database/seed.js && node src/database/seedDemoUsers.js",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
